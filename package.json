{
  "name": "scribble-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Trend-anchored, evidence-checked vertical Shorts: storyboard contract, measured Kokoro narration, HyperFrames render, review, and YouTube publishing.",
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "shorts": "node shorts.mjs",
    "doctor": "node shorts.mjs doctor",
    "setup:assets": "node scripts/setup-assets.mjs",
    "youtube:auth": "node upload-youtube.mjs auth",
    "youtube:status": "node youtube-status.mjs",
    "test": "node --test --test-concurrency=1 pipeline/tests/*.test.mjs",
    "test:integration": "node pipeline/tests/integration.mjs",
    "demo:prepare": "node pipeline/examples/prepare-demo.mjs"
  },
  "dependencies": {"zod": "4.6.7", "cheerio": "1.2.0"},
  "optionalDependencies": {
    "remotion": "4.0.544",
    "@remotion/bundler": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
